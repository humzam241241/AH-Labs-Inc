# ChatBot Configuration
NEXT_PUBLIC_CHATBOT_URL=https://your-chatbot-url.com

# Customer-facing delivery number in E.164 format
DELIVERY_SMS_NUMBER=+12893013738

# Live delivery booking through the owner-authorized Google Apps Script web app
DELIVERY_BOOKING_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
DELIVERY_BOOKING_SECRET=replace-with-a-long-random-secret

# Add these after the AH Gifts company inbox and verified Resend sender are ready
RESEND_API_KEY=re_example
PRINT_REQUEST_FROM="AH Gifts <orders@your-verified-domain.example>"
PRINT_REQUEST_TO=orders@your-company-domain.example

# Customer accounts (Google OAuth through Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Public business Interac e-Transfer recipient shown on the checkout page
NEXT_PUBLIC_INTERAC_EMAIL=your-business-interac-email@example.com
